# Postgres (Railway)
DATABASE_URL=postgresql://user:pass@host:5432/db
# pune 1 dacă te conectezi la Postgres extern cu SSL (proxy-ul public Railway)
DATABASE_SSL=0

# Cheia endpoint-ului de cron
CRON_SECRET=schimba-ma

# OpenAI (fallback global; poți pune și cheie dedicată per site)
OPENAI_API_KEY=sk-...
BOTOSANEANUL_OPENAI_API_KEY=

# Facebook — page access token (NU user token)
BOTOSANEANUL_FB_PAGE_ID=
BOTOSANEANUL_FB_ACCESS_TOKEN=

# Opțional: suprascrie feed-ul default
BOTOSANEANUL_FEED_URL=https://www.botosaneanul.ro/rss

PORT=3000
